# Copy this file to .env and add your own Groq API key.
GROQ_API_KEY=your_groq_api_key_here

# Current Groq production model used by this project.
GROQ_MODEL=openai/gpt-oss-120b

# Local embedding model used for RAG retrieval.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

CHUNK_SIZE=900
CHUNK_OVERLAP=120
TOP_K=5
